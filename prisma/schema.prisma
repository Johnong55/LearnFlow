model BackgroundJob {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?          @map("user_id") @db.Uuid
  queueName       String           @map("queue_name") @db.VarChar(100)
  externalId      String?          @map("external_id") @db.VarChar(150)
  type            String           @db.VarChar(100)
  status          JobStatus        @default(QUEUED)
  progress        Int              @default(0)
  statusMessage   String?          @map("status_message") @db.VarChar(250)
  payload         Json?
  result          Json?
  errorCode       String?          @map("error_code") @db.VarChar(100)
  errorMessage    String?          @map("error_message") @db.Text
  attempts        Int              @default(0)
  startedAt       DateTime?        @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  roadmapVersions RoadmapVersion[]

  @@unique([queueName, externalId])
  @@index([userId])
  @@index([status, createdAt])
  @@map("background_jobs")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  requestId  String?  @map("request_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.Inet
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
