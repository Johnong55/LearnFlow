[Unit]
Description=Renew LearnFlow TLS certificates
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=learnflow
Group=learnflow
WorkingDirectory=/opt/learnflow
ExecStart=/opt/learnflow/scripts/renew-certificates.sh /opt/learnflow/.env.production
PrivateTmp=true
NoNewPrivileges=true

