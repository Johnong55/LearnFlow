# Compose and public routing
COMPOSE_PROJECT_NAME=learnflow
APP_VERSION=latest
DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Application
NODE_ENV=production
APP_NAME=LearnFlow API
APP_HOST=0.0.0.0
APP_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=true
REQUEST_BODY_LIMIT=1mb
SWAGGER_ENABLED=false
LOG_LEVEL=log

# PostgreSQL: URL-encode special characters in DATABASE_URL
POSTGRES_DB=learnflow
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://learnflow:replace-with-a-long-random-database-password@postgres:5432/learnflow?schema=public

# Redis
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:replace-with-a-long-random-redis-password@redis:6379/0

# Authentication: generate distinct values with `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_DAYS=30
PASSWORD_RESET_EXPIRES_MINUTES=30
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
COOKIE_SECURE=true
COOKIE_DOMAIN=api.example.com

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Provider adapters
SEARCH_PROVIDER=mock
SEARCH_MAX_RESULTS=12
SEARCH_TIMEOUT_MS=30000
SEARCH_QUERY_CONCURRENCY=3
SEARCH_DOMAIN_ALLOWLIST=
SEARCH_DOMAIN_BLOCKLIST=
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_PROJECT_ID=
LLM_PROVIDER=mock
LLM_TIMEOUT_MS=60000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=20000
OPENAI_PROJECT_ID=
OPENAI_ORGANIZATION_ID=

# Required only when LLM_PROVIDER=cloudflare-workers-ai
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_AI_MAX_TOKENS=8192
CLOUDFLARE_AI_TEMPERATURE=0.2

# Queue processing
ROADMAP_JOB_ATTEMPTS=3
ROADMAP_JOB_BACKOFF_MS=1000
SCHEDULE_JOB_ATTEMPTS=3
SCHEDULE_JOB_BACKOFF_MS=1000
ADAPTIVE_SCHEDULE_CRON=0 2 * * *

# Maintenance
BACKUP_RETENTION_DAYS=14
