# Application
NODE_ENV=development
APP_NAME=LearnFlow API
APP_HOST=0.0.0.0
APP_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
SWAGGER_ENABLED=true
LOG_LEVEL=log

# PostgreSQL
POSTGRES_DB=learnflow
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://learnflow:change-this-local-password@localhost:5432/learnflow?schema=public

# Redis and BullMQ
REDIS_URL=redis://localhost:6379/0

# Authentication (generate distinct values with: openssl rand -base64 48)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_DAYS=30
PASSWORD_RESET_EXPIRES_MINUTES=30
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Phase 3 provider selection (mock adapters are deterministic and require no API keys)
SEARCH_PROVIDER=mock
SEARCH_MAX_RESULTS=12
SEARCH_TIMEOUT_MS=30000
SEARCH_QUERY_CONCURRENCY=3
SEARCH_DOMAIN_ALLOWLIST=
SEARCH_DOMAIN_BLOCKLIST=
# Required only when SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_PROJECT_ID=
LLM_PROVIDER=mock
LLM_TIMEOUT_MS=180000
# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=20000
OPENAI_PROJECT_ID=
OPENAI_ORGANIZATION_ID=
# Required only when LLM_PROVIDER=cloudflare-workers-ai
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_AI_FAST_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
CLOUDFLARE_AI_MAX_TOKENS=8192
CLOUDFLARE_AI_TEMPERATURE=0.2
# Required only when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=32768
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_MS=1000
GEMINI_RETRY_MAX_DELAY_MS=15000
ROADMAP_JOB_ATTEMPTS=3
ROADMAP_JOB_BACKOFF_MS=1000
ROADMAP_PERSONALIZATION_TIMEOUT_MS=900000
ROADMAP_LLM_CONCURRENCY=2

# Phase 4 deterministic schedule worker
SCHEDULE_JOB_ATTEMPTS=3
SCHEDULE_JOB_BACKOFF_MS=1000
ADAPTIVE_SCHEDULE_CRON=0 2 * * *
